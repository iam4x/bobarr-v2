# Host identity and paths. On Linux, use the owner reported by `id -u`/`id -g`.
PUID=1000
PGID=1000
TZ=Europe/Paris
BOBARR_BIND_ADDRESS=0.0.0.0
BOBARR_PORT=3000
# Keep false for direct HTTP access. Set true when Bobarr is served over HTTPS.
BOBARR_COOKIE_SECURE=false
# Must remain below Compose's stop_grace_period (30 seconds).
BOBARR_SHUTDOWN_TIMEOUT_MS=15000
BOBARR_CONFIG_PATH=./config
BOBARR_MEDIA_PATH=./media
# A released deployment can use ghcr.io/iam4x/bobarr-v2:<version>@sha256:<digest>.
BOBARR_IMAGE=bobarr-v2:0.1.0

# Optional. Leave blank to create config/master.key with mode 0600.
# To manage it externally, generate 32 random bytes as base64/base64url.
BOBARR_MASTER_KEY=

# Connector credentials
# Configure either the v4 read-access token or the v3 API key from TMDB.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
OMDB_API_KEY=
TRANSMISSION_USERNAME=bobarr
TRANSMISSION_PASSWORD=change-me
TRANSMISSION_PEER_PORT=51413
# Authenticated Transmission Web UI/RPC published on the Docker host.
TRANSMISSION_BIND_ADDRESS=0.0.0.0
TRANSMISSION_WEB_PORT=9091

# Optional Gluetun overlay. Fill the fields required by your provider.
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
VPN_SERVER_COUNTRIES=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
OPENVPN_USER=
OPENVPN_PASSWORD=

# Optional path overrides
JACKETT_CONFIG_PATH=./config/jackett
JACKETT_BIND_ADDRESS=0.0.0.0
JACKETT_PORT=9117
TRANSMISSION_CONFIG_PATH=./config/transmission
FLARESOLVERR_LOG_LEVEL=info
