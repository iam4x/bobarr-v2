{
  "name": "bobarr-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "start": "bun --cwd dist index.js",
    "build": "bun scripts/build.ts",
    "admin:reset": "bun scripts/reset-admin.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "dev": "bun --hot src/index.ts",
    "lint": "oxlint --type-check",
    "lint:fix": "oxlint --type-check --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.5.1",
    "@tanstack/react-query": "5.101.4",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.10.1",
    "hono": "4.13.0",
    "lucide-react": "1.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "react-router": "8.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "bun-plugin-tailwind": "0.1.2",
    "drizzle-kit": "0.31.10",
    "happy-dom": "20.11.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "bun"
